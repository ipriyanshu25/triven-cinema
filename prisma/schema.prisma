generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GenerationStatus {
  QUEUED
  PLANNING
  GENERATING
  STITCHING
  UPLOADING
  ANALYZING
  CANCEL_REQUESTED
  CANCELLED
  COMPLETED
  FAILED
}

enum GenerationMode {
  DIRECT
  SCENES
}

enum VideoVersionStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model Generation {
  id              String           @id @default(cuid())
  clientRequestId String?          @unique
  prompt          String           @db.Text
  enhancedPrompt  String?          @db.Text
  mode            GenerationMode
  model           String           @default("ltx-2.5")
  aspectRatio     String           @default("16:9")
  quality         String           @default("preview")
  durationSeconds Int              @default(5)
  nativeAudio     Boolean          @default(true)
  enhancePrompt   Boolean          @default(true)
  seed            Int?
  status          GenerationStatus @default(QUEUED)
  progress        Int              @default(0)
  statusMessage   String?
  providerJobId   String?
  outputUrl       String?
  thumbnailUrl    String?
  gpuType         String?
  gpuSeconds      Float?
  estimatedCost   Float?
  actualCost      Float?
  error           String?          @db.Text
  metadata        Json?
  analysis        Json?
  qcReport        Json?
  scenes          Scene[]
  versions        VideoVersion[]
  attempts        RenderAttempt[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([createdAt])
  @@index([status])
}

model Scene {
  id           String           @id @default(cuid())
  generationId String
  generation   Generation       @relation(fields: [generationId], references: [id], onDelete: Cascade)
  order        Int
  title        String
  prompt       String           @db.Text
  duration     Int              @default(5)
  seed         Int?
  status       GenerationStatus @default(QUEUED)
  videoUrl     String?
  metadata     Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([generationId, order])
}

model VideoVersion {
  id           String             @id @default(cuid())
  generationId String
  generation   Generation         @relation(fields: [generationId], references: [id], onDelete: Cascade)
  label        String             @default("Edited version")
  status       VideoVersionStatus @default(QUEUED)
  providerJobId String?
  outputUrl    String?
  thumbnailUrl String?
  operations   Json
  qcReport     Json?
  error        String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([generationId, createdAt])
  @@index([status])
}

model RenderAttempt {
  id           String           @id @default(cuid())
  generationId String
  generation   Generation       @relation(fields: [generationId], references: [id], onDelete: Cascade)
  providerJobId String?
  status       GenerationStatus @default(QUEUED)
  error        String?          @db.Text
  startedAt    DateTime         @default(now())
  finishedAt   DateTime?

  @@index([generationId, startedAt])
}
