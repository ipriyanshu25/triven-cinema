import { z } from "zod";

export const sceneSchema = z.object({
  order: z.number().int().min(1),
  title: z.string().min(1).max(120),
  prompt: z.string().min(10).max(5000),
  duration: z.number().int().min(2).max(20),
  visual: z.string().max(3000).optional(),
  action: z.string().max(3000).optional(),
  camera: z.string().max(1500).optional(),
  audio: z.string().max(1500).optional(),
  dialogue: z.string().max(1500).optional(),
  transition: z.string().max(500).optional(),
  mustHave: z.array(z.string().max(300)).max(20).optional(),
  memory: z.object({
    characterLock: z.string().max(1800),
    worldLock: z.string().max(1800),
    previousSceneSummary: z.string().max(1200).optional(),
    carryForward: z.array(z.string().max(300)).max(20),
    allowedChanges: z.array(z.string().max(300)).max(20),
    bridgeFromPrevious: z.boolean(),
  }).optional(),
});

export const planSchema = z.object({
  prompt: z.string().min(5),
  durationSeconds: z.number().int().min(5).max(180).default(20),
  aspectRatio: z.enum(["16:9", "9:16", "1:1"]).default("16:9"),
  videoType: z.enum(["cartoon", "story", "cinematic", "product-ad", "explainer", "social"]).default("cinematic"),
  continuityMode: z.enum(["creative", "balanced", "strict"]).default("balanced"),
});

const fpsSchema = z.union([
  z.literal(24),
  z.literal(25),
  z.literal(30),
  z.literal(48),
  z.literal(50),
]);

export const generationSchema = z.object({
  clientRequestId: z.string().min(8).max(100).optional(),
  prompt: z.string().min(5),
  mode: z.enum(["DIRECT", "SCENES"]),
  videoType: z.enum(["cartoon", "story", "cinematic", "product-ad", "explainer", "social"]).default("cinematic"),
  model: z.literal("ltx-2.5").default("ltx-2.5"),
  aspectRatio: z.enum(["16:9", "9:16", "1:1"]),
  quality: z.enum(["draft", "standard", "high", "ultra", "preview", "1080p"]),
  renderMode: z.enum(["fast", "pro"]).default("fast"),
  resolution: z.enum(["720p", "1080p", "1440p", "4k"]).default("1080p"),
  fps: fpsSchema.default(24),
  audioQuality: z.enum(["off", "standard", "high"]).default("standard"),
  continuityMode: z.enum(["creative", "balanced", "strict"]).default("balanced"),
  durationSeconds: z.number().int().min(2).max(180),
  nativeAudio: z.boolean(),
  enhancePrompt: z.boolean(),
  seed: z.number().int().min(0).max(2147483647).optional(),
  continuityContext: z.string().max(6000).optional(),
  scenes: z.array(sceneSchema).max(30).optional(),
}).superRefine((value, ctx) => {
  if (value.mode === "SCENES" && (!value.scenes || value.scenes.length === 0)) {
    ctx.addIssue({ code: "custom", path: ["scenes"], message: "Scene mode requires at least one scene." });
  }
});

export const editOperationsSchema = z.object({
  preset: z.enum(["custom", "cinematic", "vivid", "social", "clean"]).default("custom"),
  trimStart: z.number().min(0).max(7200).default(0),
  trimEnd: z.number().min(0).max(7200).nullable().optional(),
  speed: z.number().min(0.25).max(4).default(1),
  volume: z.number().min(0).max(2).default(1),
  mute: z.boolean().default(false),
  fadeIn: z.number().min(0).max(10).default(0),
  fadeOut: z.number().min(0).max(10).default(0),
  brightness: z.number().min(-0.5).max(0.5).default(0),
  contrast: z.number().min(0.5).max(2).default(1),
  saturation: z.number().min(0).max(3).default(1),
  sharpen: z.number().min(0).max(2).default(0),
  blur: z.number().min(0).max(12).default(0),
  vignette: z.boolean().default(false),
  normalizeAudio: z.boolean().default(false),
  crop: z.enum(["original", "16:9", "9:16", "1:1"]).default("original"),
  rotate: z.union([z.literal(0), z.literal(90), z.literal(180), z.literal(270)]).default(0),
  mirror: z.boolean().default(false),
}).superRefine((value, ctx) => {
  if (value.trimEnd != null && value.trimEnd <= value.trimStart) {
    ctx.addIssue({ code: "custom", path: ["trimEnd"], message: "Trim end must be after trim start." });
  }
});

export const editRequestSchema = z.object({
  label: z.string().trim().min(1).max(80).default("Edited version"),
  operations: editOperationsSchema,
});
