+    @staticmethod
+    def _chunk_source(source: str, max_chars: int = 12000) -> list[str]:
+        source = source.strip()
+        if len(source) <= max_chars:
+            return [source]
+        chunks: list[str] = []
+        current = ""
+        for paragraph in source.split("\n\n"):
+            paragraph = paragraph.strip()
+            if not paragraph:
+                continue
+            if len(paragraph) > max_chars:
+                if current:
+                    chunks.append(current)
+                    current = ""
+                for start in range(0, len(paragraph), max_chars):
+                    chunks.append(paragraph[start:start + max_chars])
+                continue
+            candidate = paragraph if not current else current + "\n\n" + paragraph
+            if len(candidate) > max_chars:
+                chunks.append(current)
+                current = paragraph
+            else:
+                current = candidate
+        if current:
+            chunks.append(current)
+        return chunks or [source]
+
+    def _compress_long_source(self, source: str) -> str:
+        """Hierarchically condense arbitrarily long source text without dropping the ending."""
+        working = source.strip()
+        round_index = 0
+        while len(working) > 24000:
+            chunks = self._chunk_source(working, 12000)
+            summaries: list[str] = []
+            for index, chunk in enumerate(chunks, start=1):
+                raw = self._generate([
+                    {"role": "system", "content": [{"type": "text", "text": (
+                        "You are compressing one part of a longer video story. Preserve named characters, "
+                        "visual identity details, locations, important props, chronological events, dialogue meaning, "
+                        "emotional turns, and especially any ending/resolution facts. Do not invent anything. "
+                        "Return concise production notes only."
+                    )}]},
+                    {"role": "user", "content": [{"type": "text", "text": (
+                        f"PART {index} OF {len(chunks)} (compression round {round_index + 1}):\n{chunk}"
+                    )}]},
+                ], max_new_tokens=700)
+                summaries.append(f"PART {index}/{len(chunks)}:\n{raw.strip()}")
+            working = "\n\n".join(summaries)
+            round_index += 1
+            if round_index >= 6:
+                # A practical safety valve for pathological multi-megabyte inputs. The final reduction still
+                # contains notes from every processed chunk rather than silently slicing off the ending.
+                break
+        return working
