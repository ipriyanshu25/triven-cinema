# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/triven_cinema?schema=public"

# Start with true. This completes jobs using the included demo video and costs $0.
MOCK_MODE="true"
NEXT_PUBLIC_MOCK_MODE="true"

# Scene planning is local/deterministic. No OpenAI or external LLM key is required.

# Required only when MOCK_MODE=false.
# Copy the URL printed by: modal deploy modal/cinema.py
MODAL_API_URL=""
# Must exactly match TRIVEN_WEB_SECRET in the Modal secret.
MODAL_WEB_SECRET="change-me-to-a-long-random-secret"
