# Local PostgreSQL from docker-compose.yml
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/triven_cinema?schema=public"

# $0 local UI test. Switch both to false for Modal.
MOCK_MODE="true"
NEXT_PUBLIC_MOCK_MODE="true"

# Server-side safety rail. Requests above this many active generations return HTTP 429.
TRIVEN_MAX_ACTIVE_GENERATIONS="2"

# Required when MOCK_MODE=false.
# Copy the URL printed by: modal deploy modal/cinema.py
MODAL_API_URL=""
# Must exactly match TRIVEN_WEB_SECRET in the Modal secret.
MODAL_WEB_SECRET="change-me-to-a-long-random-secret"

# Production safety / capacity
TRIVEN_MAX_ACTIVE_EDITS="4"
TRIVEN_MAX_VERSIONS_PER_GENERATION="20"
TRIVEN_ACTIVE_STALE_HOURS="6"

# Optional HTTP Basic Auth for the whole demo/app. Leave blank locally.
TRIVEN_BASIC_AUTH_USER=""
TRIVEN_BASIC_AUTH_PASSWORD=""


# Story Director v2: local open-weight full-story planning + semantic scene review
TRIVEN_STORY_DIRECTOR=true
# Override only if you intentionally switch the local Director model.
STORY_DIRECTOR_MODEL=Qwen/Qwen3-VL-4B-Instruct

# AI Story Director: allow GPU cold start + planning without silently falling back after 2 minutes.
TRIVEN_DIRECTOR_TIMEOUT_MS=480000
